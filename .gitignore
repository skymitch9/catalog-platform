# Wrangler writes its cache (account id, project name) next to wherever the
# command was run. deploy.md tells you to run from this root:
#
#     npx wrangler pages deploy sites/heygabi-home/public --project-name heygabi-home
#
# so the cache lands here, not in sites/heygabi-home/ where that site's own
# .gitignore would have caught it.
.wrangler/

# tools/universes.mjs has zero dependencies on purpose, so a fresh checkout can
# run it with no install. Nothing here should ever need node_modules — but if
# something does, it does not belong in git.
node_modules/

# ⚠️ data/universes.json is NOT ignored and never should be. It is the ONE copy
# of the shared universe list; library_catalog and audiobook_catalog both read
# it at build time. Ignoring it breaks two builds in another repo, silently.

# Local Worker secrets (apps/index-worker/.dev.vars): push tokens for wrangler
# dev. Never committed — the real ones are Worker secrets.
.dev.vars

# D1 exports and Firestore dumps land here when backup.yml's steps or
# scripts/backup-firestore.mjs run locally (CI uploads the same tree as an
# artifact and never commits it). These are household database contents —
# emails, Firebase UIDs, review text — and must never be tracked. See
# docs/access/backup-restore.md.
backups/

# OS and editor cruft.
Thumbs.db
desktop.ini
.DS_Store
.vscode/
*.swp

# ⚠️ Unlisted pages: everything under public/r/ is deploy-only, NEVER committed.
# This repo is PUBLIC on GitHub — committing a page here would put its
# "hidden" URL in the open history, which defeats the entire mechanism. The
# slug paths are recorded in audiobook_catalog's LOCAL-ONLY docs
# (docs/access/SHELF_SERVER.md and siblings). Deploys upload the working
# tree, so gitignored pages still ship — that is the one sanctioned use of
# that property (the general rule stays: deploy only from committed-clean
# trees; ignored files under public/r/ do not count as dirt).
sites/heygabi-home/public/r/
