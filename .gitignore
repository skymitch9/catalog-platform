# Wrangler writes its cache (account id, project name) next to wherever the
# command was run. deploy.md tells you to run from this root:
#
#     npx wrangler pages deploy sites/heygabi-home/public --project-name heygabi-home
#
# so the cache lands here, not in sites/heygabi-home/ where that site's own
# .gitignore would have caught it.
.wrangler/

# tools/universes.mjs has zero dependencies on purpose, so a fresh checkout can
# run it with no install. Nothing here should ever need node_modules — but if
# something does, it does not belong in git.
node_modules/

# ⚠️ data/universes.json is NOT ignored and never should be. It is the ONE copy
# of the shared universe list; library_catalog and audiobook_catalog both read
# it at build time. Ignoring it breaks two builds in another repo, silently.

# Local Worker secrets (apps/index-worker/.dev.vars): push tokens for wrangler
# dev. Never committed — the real ones are Worker secrets.
.dev.vars

# OS and editor cruft.
Thumbs.db
desktop.ini
.DS_Store
.vscode/
*.swp
