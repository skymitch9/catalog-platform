# Copy to .dev.vars (gitignored) for `npm run dev`. The live probe suite
# (`npm run probe`) passes its own --var flags and needs none of this.
ENVIRONMENT=development
DEV_EMAIL=nbaslamking@gmail.com
FIREBASE_PROJECT_ID=audiobook-catalog
OWNER_EMAILS=nbaslamking@gmail.com
# The apex admin page's dev origin, alongside production.
ADMIN_ORIGINS=https://heygabi.ai,http://localhost:8080
# Browsers allowed on GET /api/estate/me — wider than ADMIN_ORIGINS on purpose
# (the audiobook site calls it); unset ⇒ /me falls back to ADMIN_ORIGINS.
ME_ORIGINS=https://heygabi.ai,https://audiobooks.heygabi.ai,http://localhost:8080
# Per-consumer bearer tokens for /api/estate/seen — any long random values locally.
ESTATE_APP_TOKEN_LIBRARY=dev-library-token
ESTATE_APP_TOKEN_GAMES=dev-games-token
ESTATE_APP_TOKEN_INDEX=dev-index-token
# POST /api/estate/ops/pipeline — must equal audiobook_catalog's own
# PIPELINE_TRIGGER_TOKEN (.env there) for a local watcher to ever accept a
# request written from local dev. Leave unset to exercise the 503 path.
PIPELINE_TRIGGER_TOKEN=
# FIREBASE_SERVICE_ACCOUNT is deliberately absent from this example — it is
# the whole service-account JSON (site-roles.ts + ops.ts both need it) and
# is never typed into a file even as a placeholder; `wrangler secret put` in
# production, or paste the real JSON into your own gitignored .dev.vars.

# Phase 2 session service (sso-design.md §4.3, docs/access/estate-auth.md).
# COOKIE_DOMAIN: Domain=.heygabi.ai can never be set from a localhost origin
# — override for local dev so the Set-Cookie is actually usable in-browser.
COOKIE_DOMAIN=localhost
# SESSION_ORIGINS: unset falls back to the production four (env.ts) — only
# needed locally if testing from a dev origin other than those.
SESSION_ORIGINS=https://heygabi.ai,https://audiobooks.heygabi.ai,https://library.heygabi.ai,https://boardgames.heygabi.ai,http://localhost:8080
# TOKEN_SIGNER_KEY is deliberately absent from this example, same reasoning
# as FIREBASE_SERVICE_ACCOUNT above — but it MUST be a DIFFERENT, dedicated,
# zero-IAM-role service account, never the same key. See
# docs/access/estate-auth.md §3 for what it is and how to create/rotate it.
# Left unset, POST /api/session/token answers 503 token_signer_unset.
