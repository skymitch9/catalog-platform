{
  "name": "@platform/auth-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The estate directory: pending/approved/revoked membership for every heygabi.ai consumer. Design: docs/info/estate-auth-design.md (4, 14.1).",
  "scripts": {
    "dev": "wrangler dev --port 8799",
    "db:migrate:local": "wrangler d1 migrations apply estate_auth --local",
    "db:migrate": "wrangler d1 migrations apply estate_auth --remote",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "probe": "tsx test/live-probes.ts"
  },
  "dependencies": {
    "@platform/estate-auth": "*",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
